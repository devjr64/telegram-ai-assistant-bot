# Telegram Bot - Environment Variables
# Copy this file to .env and fill in your values

# Docker restart policy: use 'no' for development and 'always' in production.
RESTART_POLICY=no

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# OpenCode Go API Key (from https://opencode.ai/auth)
OPENCODE_GO_API_KEY=your_api_key_here

# AI provider: 'opencode' (default) or 'gemini'.
# The provider is fixed by this file and cannot be changed from the chat
# (there is no /provider command or tool for it). Apply changes by
# editing .env and restarting the container.
AI_PROVIDER=opencode

# Google Gemini API Key (from https://aistudio.google.com/) — only needed
# when using AI_PROVIDER=gemini.
# ⚠️ PRODUCCIÓN: si quieres Gemini en el VPS, añade esta key a mano en el
# .env del servidor (~/telegram-bot/.env). Los deploys NO tocan ese archivo.
GEMINI_API_KEY=

# Model configuration (default: mimo-v2.5 — económicos)
# Opciones económicas: deepseek-v4-flash, mimo-v2.5
MODEL=mimo-v2.5

# Gemini model (used when AI_PROVIDER=gemini). Default is the most
# cost-effective (more free quota): gemini-3.1-flash-lite. Alternatives:
# gemini-3.5-flash-lite, gemini-3.6-flash, gemini-2.5-flash...
GEMINI_MODEL=gemini-3.1-flash-lite

# Gemini model used for media processing (voice transcription + photo
# analysis). gemini-3.6-flash is the cheapest model that supports both
# audio (input_audio) and vision (image_url) on the free tier.
GEMINI_MEDIA_MODEL=gemini-3.6-flash

# Gemini model used for image generation (/imagine). gemini-2.5-flash-image
# (Nano Banana) is the only image generator available on the free tier.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Daily media caps per user (reset at midnight, timezone-dependent).
# Protects the free-tier quota. 0 disables the cap.
MEDIA_IMAGE_DAILY_LIMIT=30
MEDIA_AUDIO_DAILY_LIMIT=30

# API endpoint (should not need to change)
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Comma-separated Telegram user IDs allowed to use the bot
# (Find your ID with @userinfobot on Telegram)
# IMPORTANT: if empty/missing, the bot denies access to everyone (fail-secure)
AUTHORIZED_USERS=111111111,222222222,333333333,444444444

# Chat context: max messages to keep per user (controls token usage)
MAX_CONTEXT_MESSAGES=30

# Rate limiting: seconds between messages per user
RATE_LIMIT_SECONDS=5

# Max tool-call rounds per message in the AI loop (safety valve against
# runaway loops). Each round = one API call; 12 covers multi-action requests
# without doubling the worst case on a real loop.
MAX_TOOL_ROUNDS=12

# Auto-journal: extract events from chat history and save to bitácora
# automatically. Runs every AUTO_JOURNAL_INTERVAL (3600=60min, 75% ahorro vs 30min),
# reviews last 3h of messages. Event-driven: <AUTO_JOURNAL_MIN_MESSAGES skips
# unless 3×interval fallback due. 1 call (events+entities) vs 2 antes.
AUTO_JOURNAL_ENABLED=true
AUTO_JOURNAL_INTERVAL=3600
AUTO_JOURNAL_MIN_MESSAGES=6

# System prompt: personality for the AI (default is Spanish, understands
# project statuses/priorities, the long-term memory (bitácora) and executes
# everything by natural language).
# Leave it commented out to use the built-in default (recommended).
# ⚠️ PRODUCCIÓN: si antes definiste SYSTEM_PROMPT en el .env del VPS
# (~/telegram-bot/.env), ese valor viejo seguirá usándose y desactivará las
# reglas nuevas (estados/prioridades en español, memoria/proactividad de la
# bitácora). Para activarlas, edita a mano el .env del servidor y borra o
# actualiza esa línea — los deploys NO tocan ese archivo.
# SYSTEM_PROMPT=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Data directory for SQLite persistence (Docker overrides this to /app/data)
DATA_DIR=.

# Timezone for scheduled messages and reminders (IANA name)
TIMEZONE=America/Caracas

# Long-term memory ("bitácora"): per-user journal + hierarchical summaries.
# MEMORY_ENABLED=false desactiva el guardado de la bitácora y las tools de memoria.
MEMORY_ENABLED=true

# Word threshold that triggers the nightly daily-compact summary for a day.
# Days below this are left as raw entries only (no summary cost). A higher
# threshold means fewer nightly compactions (cheaper nights) but slightly
# larger weekly-summary prompts (raw text is used until a day is compacted).
MEMORY_DAILY_COMPACT_WORDS=1200

# Proactive assistant: morning/evening check-ins and proactive reminders
# based on journal patterns (streaks, absences, pending items).
PROACTIVE_ENABLED=true

# Default check-in times (HH:MM, 24h) in the TIMEZONE above. These are the
# DEFAULT times: each user can change their own from the chat by natural
# language ("cambia mi check-in de la mañana a las 9" -> tool set_checkin_time).
PROACTIVE_MORNING_TIME=08:00
PROACTIVE_EVENING_TIME=20:00

# Max proactive messages sent to a user per day (anti-annoyance cap).
PROACTIVE_MAX_DAILY=3
